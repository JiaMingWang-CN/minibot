{
  "appId": "com.minibot.desktop",
  "productName": "minibot",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "**/node_modules/@vscode/ripgrep/bin/**"
  ],
  "extraResources": [
    {
      "from": "../../packages/builtin-plugins",
      "to": "builtin-plugins"
    }
  ],
  "icon": "static/assets/icon.png",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "artifactName": "minibot-setup-${version}.${ext}"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "JiaMingWang-CN",
      "repo": "minibot"
    }
  ]
}
