{
  "name": "minibot",
  "version": "0.1.2",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/relay",
    "apps/desktop",
    "apps/renderer",
    "apps/mobile"
  ],
  "scripts": {
    "build": "npm run build --workspace @minibot/core && npm run build --workspace @minibot/relay && npm run build --workspace @minibot/desktop && npm run build --workspace @minibot/renderer",
    "start": "npm run start --workspace @minibot/desktop",
    "pack": "npm run build && npm run pack --workspace @minibot/desktop",
    "lint": "eslint .",
    "test": "node --test \"packages/core/test/*.test.ts\" \"packages/relay/test/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
